{
  "name": "lingoarena-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "yarn build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "redis:start": "docker run -d -p 6379:6379 --name lingoarena-redis --restart unless-stopped redis:alpine || docker start lingoarena-redis",
    "redis:stop": "docker stop lingoarena-redis",
    "redis:logs": "docker logs -f lingoarena-redis",
    "redis:ping": "docker exec lingoarena-redis redis-cli ping",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli -d ./src/typeorm/typeorm.config.ts",
    "db:create": "ts-node ./src/database/create-database.ts",
    "migration:generate": "yarn db:create && yarn typeorm migration:generate ./src/migrations/migration_name",
    "migration:create": "yarn ts-node ./node_modules/typeorm/cli migration:create ./src/migrations/migration_name",
    "migration:run": "yarn db:create && yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "migration:run:dev": "cross-env NODE_ENV=development yarn migration:run",
    "migration:run:prod": "cross-env NODE_ENV=production yarn migration:run",
    "migration:show": "yarn typeorm migration:show",
    "seed": "ts-node -r tsconfig-paths/register ./src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.29",
    "@pgsql/traverse": "^18.7.7",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.9",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-validator-jsonschema": "^5.1.0",
    "cloudinary": "^2.10.0",
    "dayjs": "^1.11.21",
    "express-basic-auth": "^1.2.1",
    "extensionsjs": "^1.2.0",
    "firebase-admin": "^14.2.0",
    "nanoid": "^6.0.1",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^9.0.5",
    "p-queue": "^6.6.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pgsql-deparser": "^18.3.6",
    "pgsql-parser": "^18.2.6",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.3",
    "sql-formatter": "^15.8.2",
    "typeorm": "^1.1.0",
    "typeorm-transactional": "^0.5.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cache-manager": "^4.0.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
