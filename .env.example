
NODE_ENV=development
PORT=4041
TZ=Asia/Ho_Chi_Minh
REQUEST_TIMEOUT=180000

SWAGGER_USER=
SWAGGER_PASSWORD=
SWAGGER_TITLE=
SWAGGER_DESCRIPTION=
SWAGGER_VERSION=

KEY_SECRET=
KEY_SCHEDULE=

DATABASE_URL=
DB_PRIMARY_TYPE=
DB_PRIMARY_HOST=localhost
DB_PRIMARY_PORT=5432
DB_PRIMARY_USERNAME=postgres
DB_PRIMARY_PASSWORD=root
DB_PRIMARY_DATABASE=lingoarena-dev
DB_PRIMARY_SSL=true
DB_PRIMARY_SSL_REJECT_UNAUTHORIZED=false
DB_PRIMARY_LOGGING=false

JWT_SECRET=JWT_SECRET
JWT_EXPIRY=10h
JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_EXPIRY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4300/api/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:2504/oauth-callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4300/api/auth/facebook/callback
FACEBOOK_FRONTEND_REDIRECT_URL=http://localhost:2504/oauth-callback

# AWS S3
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
LINK_UPLOAD_S3=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CATBOX_USERHASH=

# Email
EMAIL_VALIDATE_ACCOUNT=
EMAIL_VALIDATE_PASSWORD=
ADMIN_EMAIL=

# Frontend URLs
WEB_FE_URL=
WEB_FE_ACADEMY_URL=
CUSTOMER_URL=http://localhost:2504

# Webhook / Order
BACKEND_WEBHOOK_URL=
CANCEL_ORDER_MINUTES=15

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_RESOURCE_PATH_FILE=

# External API
EXTERNAL_API_HOST=
EXTERNAL_API_PATH=

# Zalo ZNS
ZNS_SECRETKEY=
ZNS_APP_ID=

# Rate limiting
LIMIT_RQ_PER_SECOND_PER_IP=10
LIMIT_RQ_PER_MINUTE_PER_IP=100

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Project meta
PROJECT_NAME=
SOURCE_CODE=
ENVIRONMENT=
LOG_URL=

# Performance thresholds (monitoring)
PERF_THRESHOLD_DURATION=
PERF_THRESHOLD_MEMORY=500
PERF_THRESHOLD_CPU=500
PERF_THRESHOLD_STALL=500

# Telegram notification
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VietQR
VIETQR_URL=
VIETQR_USERNAME=
VIETQR_PASSWORD=
VIETQR_CALLBACK_URL=
VIETQR_JWT_SECRET=

# Translate — production MUST set Azure or Google. MyMemory is local-only.
# auto picks Azure → Google → MyMemory (dev). Production rejects MyMemory.
# Azure F0: 2M chars/month free. Create a Translator resource:
# https://portal.azure.com → Create → Translator → Pricing F0
# Google Cloud Translation: 500k chars/month free, then ~$20/million
TRANSLATE_PROVIDER=auto
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
GOOGLE_TRANSLATE_API_KEY=
TRANSLATE_MYMEMORY_EMAIL=

# Recaptcha / Sysadmin
RECAPTCHA_SECRET=
RECAPTCHA_ALLOWED_HOSTNAMES=
SYSADMIN_PASSWORD=

# Misc
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
MILLISECOND_OTP_EFFECT=300000